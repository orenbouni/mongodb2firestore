# Copy to .env and fill in your own values. .env is gitignored; this file is not,
# so keep real project ids, host names and IP addresses out of it.

# ---- Google Cloud / Firestore ----
# Credentials resolve through Application Default Credentials (ADC).
#   Local dev : gcloud auth application-default login
#   On GCP    : Workload Identity / attached service account (roles/datastore.user)
# Leave GCP_PROJECT_ID empty to let ADC detect the active project.
GCP_PROJECT_ID=your-project-id
FIRESTORE_DATABASE_ID=aegis-legends

# Optional: point at the local emulator instead of real Firestore.
# When set, credential resolution is skipped entirely.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ---- MongoDB ----
# The demo expects a MongoDB VM whose VPC only allows IAP ingress, reached over
# an IAP TCP tunnel rather than a public IP:
#   gcloud compute start-iap-tunnel <vm-name> 27017 \
#     --local-host-port=localhost:27018 --zone=<zone> --project=<project-id>
MONGODB_URI=mongodb://127.0.0.1:27018/?directConnection=true
MONGODB_DB=aegis_legends

# Cosmetic only - shown in the dashboard's connection panel so you can tell
# which host you are pointed at. Leave the IPs blank to hide those rows.
# Quote any value containing spaces or parentheses: the shell scripts source
# this file directly, and dotenv strips the quotes for the Node process.
MONGODB_HOST_LABEL="mongo-demo-vm (GCE) via IAP tunnel"
MONGODB_VM_INTERNAL_IP=
MONGODB_VM_EXTERNAL_IP=

# Used by scripts/mongo-tunnel.sh
MONGO_VM=mongo-demo-vm
MONGO_ZONE=us-central1-a
MONGO_LOCAL_PORT=27018

# ---- Server ----
PORT=8080
DEFAULT_DATA_SOURCE=firestore
